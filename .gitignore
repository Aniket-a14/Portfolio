# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public
.env*.local

# Local Claude Code plugin/skill enablement (per-machine, not shared)
.claude/

# npx skills lock file (local skill install state, not shared)
skills-lock.json

# Local design exploration lab (not part of the site)
design-lab/

# Trailer kit (captures and renders are binaries; rebuilt with npm run all)
trailer-kit/

# Trailer film is hosted on Vercel Blob; the local copy is for development only
public/trailer/film*.mp4
